  "narrative": {
    "northStar": "El archivo del abuelo",
    "overview": "Un cajón de documentos familiares: fichas mecanografiadas, papel crema, tinta de cinta y un sello de lacre terracota. La calidez viene del material, no de adornos. Todo lo que se lee y se toca está pensado para quien no es experto: letra grande, botones amplios, un solo camino principal por pantalla, mensajes en tono de conversación.",
    "keyCharacteristics": [
      "Un botón negro principal por pantalla.",
      "Mínimo 48 px de alto en lo táctil, texto de 18 px (nunca menos de 16 px).",
      "Íconos siempre acompañados de su palabra.",
      "Plano y redondeado: píldoras y tarjetas de borde grueso."
    ],
    "rules": [
      { "name": "The One Seal Rule", "body": "El terracota es el único acento; no se suman otros.", "section": "colors" },
      { "name": "The Never Color Alone Rule", "body": "Ningún estado ni sexo se comunica solo con color.", "section": "colors" },
      { "name": "The Typewriter Voice Rule", "body": "Special Elite solo en logo, títulos y cifras destacadas; nunca en texto de lectura.", "section": "typography" },
      { "name": "The Flat Interface Rule", "body": "Botones, campos y listas no llevan sombra.", "section": "elevation" }
    ],
    "dos": [
      "Do usar un solo botón negro principal por pantalla.",
      "Do mantener 48 px mínimo en todo lo tocable y texto de 18 px (16 px como piso).",
      "Do acompañar cada ícono con su palabra y cada color de estado con texto.",
      "Do escribir mensajes de conversación en español de Chile."
    ],
    "donts": [
      "Don't introducir un segundo color de acento.",
      "Don't usar Special Elite para párrafos.",
      "Don't añadir sombras a botones, campos o listas.",
      "Don't reducir texto bajo 16 px fuera del árbol."
    ]
  }
